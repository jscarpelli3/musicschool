NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Prefer the current sb_secret_ key from Supabase API settings.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Server-only Stripe Connect configuration. Never prefix these with NEXT_PUBLIC_.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_endpoint_secret
# Optional second destination for platform-context Accounts v2 events.
STRIPE_PLATFORM_WEBHOOK_SECRET=whsec_your_platform_endpoint_secret
# Optional connected-account snapshot destination for Checkout and payment events.
STRIPE_PAYMENTS_WEBHOOK_SECRET=whsec_your_payments_endpoint_secret

# Public application origin used only to construct trusted Stripe return URLs.
APP_URL=http://localhost:3001

# Server-only Twilio credentials. Use a scoped API key in deployed environments.
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_account_auth_token
TWILIO_API_KEY_SID=SK_your_api_key_sid
TWILIO_API_KEY_SECRET=your_api_key_secret
TWILIO_MESSAGING_SERVICE_SID=MG_your_messaging_service_sid
